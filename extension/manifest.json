{
  "manifest_version": 3,
  "name": "Перо — локальный ИИ",
  "short_name": "Перо AI",
  "version": "1.2.0",
  "description": "Локальный ИИ в боковой панели браузера. Работает с Ollama на вашем компьютере.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Открыть Перо" },
  "side_panel": { "default_path": "panel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
